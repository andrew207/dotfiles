/* Waybar Workspaces modules */

/* Generally, this is a potential expanding of choices for hyprland/workspace */
// HYPRLAND WORKSPACES. CHOOSE as desired and place on waybar configs

{
// NUMBERS and ICONS style with window rewrite 
"hyprland/workspaces#rw": {
	"disable-scroll": true,
	"all-outputs": true,
	"warp-on-scroll": false,
	"sort-by-number": true,
	"show-special": false,
	// No "on-click" here: hyprland/workspaces handles clicks inside waybar and
	// ignores the key ("activate" is a sway/workspaces option). Waybar <= 0.15.0
	// sends the legacy `dispatch workspace <id>`, which Hyprland's Lua config
	// rejects as a syntax error, so clicking is a no-op until Arch ships a waybar
	// newer than 0.15.0 (fixed upstream in e17c0d9). No config change needed then.
	// Scrolling is ours to fix: under the Lua config the dispatch payload is
	// evaluated as Lua, so legacy `hyprctl dispatch workspace e+1` cannot parse.
	"on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
	"on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
	"persistent-workspaces": {
		"*": 5
	  },
	"format": "{icon} {windows}",
	"format-window-separator": " ",
	"window-rewrite-default": " ",
	"window-rewrite": {		
		"title<.*amazon.*>": " ",
		"title<.*reddit.*>": " ",

		"class<firefox|org.mozilla.firefox|librewolf|floorp|mercury-browser|[Cc]achy-browser>": " ",
		"class<Chromium|Thorium|[Cc]hrome>": " ",

		"class<foot>": " ",
		"class<kitty>": " ",
		"class<kitty-dropterm>": " ",

		"title<.*gmail.*>": "󰊫 ",

		"title<.*whatsapp.*>": " ",
	        "title<.*zapzap.*>": " ",
		"title<.*messenger.*>": " ",
		"title<.*facebook.*>": " ",

		"title<.*ChatGPT.*>": "󰚩 ",
		"title<.*deepseek.*>": "󰚩 ",
		"title<.*qwen.*>": "󰚩 ",

		"class<mpv>": " ",
